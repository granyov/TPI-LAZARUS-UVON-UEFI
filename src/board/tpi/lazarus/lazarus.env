/* SPDX-License-Identifier: GPL-2.0+ */
/*
 * Окружение по умолчанию TPI LAZARUS UVON.
 *
 * Окружение хранится на eMMC (две копии: 12 МиБ и 12 МиБ + 64 КиБ), но из
 * сохранённого U-Boot берёт только переменные из CFG_ENV_FLAGS_LIST_STATIC
 * (include/configs/tpi_lazarus_rk3568.h): сейчас это tpi_boot_order. Скрипты
 * ниже всегда приходят из прошивки, и обновление прошивки их не теряет.
 *
 * Файл проходит через препроцессор: только комментарии вида слэш-звёздочка,
 * продолжения строк — с отступом, команды разделяются точкой с запятой.
 */

/*
 * Порядок загрузки — носители через пробел, перебираются слева направо:
 *   scsi — SATA SSD, mmc0 — eMMC, mmc2 — microSD, usb — USB-накопитель,
 *   any  — все носители и сеть, включая записи менеджера загрузки UEFI.
 * Сервисная утилита tpi-uvon меняет его в сохранённом окружении.
 */
tpi_boot_order=scsi mmc0 mmc2 usb any

tpi_boot=
	for t in ${tpi_boot_order}; do
		run tpi_boot_${t};
	done;
	echo "TPI: nothing booted from: ${tpi_boot_order}";
	echo "TPI: recovery menu - hold RECOVERY at power-on or type: run tpi_recovery"

/*
 * label-сканирование bootflow само носители не ищет: SATA и USB нужно
 * опросить заранее, иначе их bootdev ещё не существует.
 */
tpi_boot_scsi=
	echo "TPI: boot from SATA SSD";
	scsi scan;
	bootflow scan -lbG scsi
tpi_boot_mmc0=
	echo "TPI: boot from eMMC";
	bootflow scan -lbG mmc0
tpi_boot_mmc2=
	echo "TPI: boot from microSD";
	bootflow scan -lbG mmc2
tpi_boot_usb=
	echo "TPI: boot from USB drive";
	usb start;
	bootflow scan -lbG usb
tpi_boot_any=
	echo "TPI: boot from any device";
	bootflow scan -lb

/*
 * Меню Recovery. Его открывает кнопка RECOVERY при включении (board-файл
 * ставит preboot) или команда run tpi_recovery. Без выбора через
 * tpi_recovery_delay секунд включается пункт 0 — режим LOADER для RKDevTool,
 * как в руководстве. Пункты, после которых есть смысл выбрать что-то ещё,
 * возвращают в меню; после выхода из меню автозагрузки нет — консоль.
 * Ctrl+C завершает LOADER и режим дисков и остаётся «нажатым»: hush прервал
 * бы им и цикл меню, поэтому после них tpi_ctrlc_clear (board-файл).
 */
tpi_recovery_delay=5
tpi_recovery=
	setenv tpi_menu_delay ${tpi_recovery_delay};
	setenv tpi_menu_again 1;
	while test "${tpi_menu_again}" = 1; do
		setenv tpi_menu_again 0;
		bootmenu ${tpi_menu_delay};
		setenv tpi_menu_delay -1;
	done;
	setenv bootdelay -1

bootmenu_0=RKDevTool: LOADER mode (rockusb, eMMC)=
	rockusb 0 mmc 0;
	tpi_ctrlc_clear;
	run tpi_after_loader;
	setenv tpi_menu_again 1
bootmenu_1=Boot service medium: microSD=
	run tpi_boot_mmc2;
	setenv tpi_menu_again 1
bootmenu_2=Boot service medium: USB drive=
	run tpi_boot_usb;
	setenv tpi_menu_again 1
bootmenu_3=USB mass storage: eMMC + SATA SSD=
	run tpi_ums;
	setenv tpi_menu_again 1
bootmenu_4=Continue normal boot=
	run tpi_boot
bootmenu_5=Boot order: SATA SSD first (default)=
	env default tpi_boot_order;
	saveenv;
	setenv tpi_menu_again 1
bootmenu_6=Boot order: eMMC first=
	setenv tpi_boot_order mmc0 scsi mmc2 usb any;
	saveenv;
	setenv tpi_menu_again 1
bootmenu_7=MaskROM mode (BootROM USB download)=
	mw.l 0xfdc20200 0xef08a53c;
	reset

/*
 * Носители платы как USB-диски: eMMC — LUN 0, SATA — LUN 1, если диск есть.
 * Состав уходит в имя USB-устройства (board-файл): по нему сервисная
 * утилита на ПК узнаёт плату и отличает eMMC от SATA. Выход — Ctrl+C или
 * «извлечь» на ПК. Тип носителя у каждого LUN свой (патч
 * ums-lun-devtypes.patch). ПК мог сменить порядок загрузки — после выхода
 * он перечитывается с eMMC (env load берёт только tpi_boot_order).
 */
tpi_ums=
	scsi scan;
	if scsi dev 0; then
		setenv tpi_ums_luns "eMMC, SATA";
		ums 0 mmc,scsi 0,0;
	else
		setenv tpi_ums_luns eMMC;
		ums 0 mmc 0;
	fi;
	tpi_ctrlc_clear;
	env load

/*
 * Сервисная утилита на ПК переводит плату из LOADER в режим дисков командой
 * сброса Rockchip с кодом 1: rockusb завершается, board-файл ставит
 * tpi_next=ums. Когда ПК «извлечёт» диски, плата грузится как обычно.
 */
tpi_after_loader=
	if test "${tpi_next}" = ums; then
		setenv tpi_next;
		run tpi_ums;
		run tpi_boot;
	fi
