diff --git a/cmd/usb_mass_storage.c b/cmd/usb_mass_storage.c
--- a/cmd/usb_mass_storage.c
+++ b/cmd/usb_mass_storage.c
@@ -54,9 +54,14 @@
 
 #define UMS_NAME_LEN 16
 
-static int ums_init(const char *devtype, const char *devnums_part_str)
+/*
+ * devtypes may name one type per LUN, e.g. "mmc,scsi" with "0,0"; the last
+ * type covers the remaining LUNs, so a single type still applies to all.
+ */
+static int ums_init(const char *devtypes, const char *devnums_part_str)
 {
-	char *s, *t, *devnum_part_str, *name;
+	char *s, *t, *types, *tt, *devnum_part_str, *name;
+	const char *devtype = NULL;
 	struct blk_desc *block_dev;
 	struct disk_partition info;
 	int partnum;
@@ -64,16 +69,23 @@
 	struct ums *ums_new;
 
 	s = strdup(devnums_part_str);
-	if (!s)
+	types = strdup(devtypes);
+	if (!s || !types) {
+		free(s);
+		free(types);
 		return -1;
+	}
 
 	t = s;
+	tt = types;
 	ums_count = 0;
 
 	for (;;) {
 		devnum_part_str = strsep(&t, ",");
 		if (!devnum_part_str)
 			break;
+		if (tt)
+			devtype = strsep(&tt, ",");
 
 		partnum = part_get_info_by_dev_and_name_or_num(devtype, devnum_part_str,
 							       &block_dev, &info, 1);
@@ -130,6 +142,7 @@
 
 cleanup:
 	free(s);
+	free(types);
 
 	if (ret < 0)
 		ums_fini();
@@ -260,5 +273,6 @@
 U_BOOT_CMD(ums, 4, 1, do_usb_mass_storage,
 	"Use the UMS [USB Mass Storage]",
 	"<USB_controller> [<devtype>] <dev[:part]>  e.g. ums 0 mmc 0\n"
-	"    devtype defaults to mmc"
+	"    devtype defaults to mmc\n"
+	"    several LUNs: ums 0 mmc 0,1; a type per LUN: ums 0 mmc,scsi 0,0"
 );
