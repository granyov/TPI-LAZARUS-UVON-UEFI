+/* Flash info as Rockchip loaders report it; sizes are in 512-byte sectors */
+struct rk_flash_info {
+	u32	flash_size;
+	u16	block_size;
+	u8	page_size;
+	u8	ecc_bits;
+	u8	access_time;
+	u8	manufacturer;
+	u8	flash_mask;
+} __packed;
 
+static void cb_read_flash_info(struct usb_ep *ep, struct usb_request *req)
+{
+	ALLOC_CACHE_ALIGN_BUFFER(struct fsg_bulk_cb_wrap, cbw,
+				 sizeof(struct fsg_bulk_cb_wrap));
+	struct f_rockusb *f_rkusb = get_rkusb();
+	struct rk_flash_info finfo = {
+		.block_size = 1024,
+		.page_size = 4,
+		.access_time = 40,
+	};
+
+	memcpy((char *)cbw, req->buf, USB_BULK_CB_WRAP_LEN);
+
+	if (!f_rkusb->desc)
+		f_rkusb->desc = blk_get_dev(f_rkusb->dev_type,
+					    f_rkusb->dev_index);
+	if (f_rkusb->desc && f_rkusb->desc->type != DEV_TYPE_UNKNOWN) {
+		finfo.flash_size = (u32)f_rkusb->desc->lba;
+		finfo.flash_mask = 1;
+	}
+
+	/* Prepare for sending subsequent CSW_GOOD */
+	f_rkusb->tag = cbw->tag;
+	f_rkusb->in_req->complete = tx_handler_send_csw;
+
+	rockusb_tx_write((char *)&finfo, sizeof(finfo));
+}
