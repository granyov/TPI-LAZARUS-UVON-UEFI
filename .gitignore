__pycache__/
*.pyc
.DS_Store
*.cmd

# Апстримное дерево U-Boot и каталог сборки держатся локально.
u-boot/
build/
output/

# Vendor-входы не распространяются: их условия использования сохраняются.
vendor/

# Собранные образы содержат заводские payload'ы TF-A и OP-TEE и здесь не
# распространяются. Они лежат в закрытом репозитории TPI.
release/*.img
release/*.bin
